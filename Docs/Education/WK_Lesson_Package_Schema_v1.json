{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://webkurier.example/schemas/education/lesson-package-v1.schema.json",
  "title": "WebKurier Education Lesson Package v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion","courseId","lessonId","week","sequence","language","title","objectives","duration","sections","evidenceModel","engineeringCycle","tts","reviewPipeline","provenance"],
  "properties": {
    "schemaVersion": {"const":"1.0.0"},
    "courseId": {"type":"string","minLength":1},
    "lessonId": {"type":"string","pattern":"^[a-z0-9._-]+$"},
    "week": {"type":"integer","minimum":1},
    "sequence": {"type":"integer","minimum":1},
    "language": {"type":"string","enum":["ru","uk","de","en"]},
    "title": {"type":"string","minLength":1},
    "objectives": {"type":"array","minItems":1,"items":{"type":"string"}},
    "duration": {
      "type":"object",
      "additionalProperties":false,
      "required":["targetMinutes","wordCountTarget","explicitPauseSeconds"],
      "properties":{
        "targetMinutes":{"type":"object","required":["min","max"],"properties":{"min":{"type":"number","minimum":1},"max":{"type":"number","minimum":1}}},
        "wordCountTarget":{"type":"object","required":["min","max"],"properties":{"min":{"type":"integer","minimum":1},"max":{"type":"integer","minimum":1}}},
        "explicitPauseSeconds":{"type":"integer","minimum":0}
      }
    },
    "sections":{
      "type":"array","minItems":1,
      "items":{"type":"object","additionalProperties":false,"required":["id","kind","narration"],
        "properties":{
          "id":{"type":"string","pattern":"^[a-z0-9._-]+$"},
          "kind":{"type":"string","enum":["intro","concept","story","history","checkpoint","summary","assignment"]},
          "narration":{"type":"string"},
          "pauseAfterSeconds":{"type":"integer","minimum":0,"maximum":30},
          "visualRefs":{"type":"array","items":{"type":"string"}},
          "checkpoint":{"type":["object","null"]}
        }}
    },
    "visuals":{"type":"array","items":{"type":"object","required":["id","description"],"properties":{"id":{"type":"string"},"description":{"type":"string"},"sourcePolicy":{"type":"string"}}}},
    "evidenceModel":{"type":"array","const":["VERIFIED","INFERRED","UNKNOWN"]},
    "engineeringCycle":{"type":"array","const":["Inspect","Understand","Plan","Implement","Test","Review"]},
    "tts":{"type":"object","additionalProperties":false,"required":["scriptFile","voiceStyle","speedGuidance","pauseSyntax"],
      "properties":{"scriptFile":{"type":"string"},"voiceStyle":{"type":"string"},"speedGuidance":{"type":"string"},"pauseSyntax":{"type":"string"},"audioFile":{"type":["string","null"]}}},
    "reviewPipeline":{"type":"array","items":{"type":"object","required":["role","tool","required"],"properties":{"role":{"type":"string"},"tool":{"type":"string"},"required":{"type":"boolean"},"trigger":{"type":"string"}}}},
    "provenance":{"type":"object","required":["canonicalStatus","createdAt","finalReviewer"],
      "properties":{"canonicalStatus":{"type":"string","enum":["DRAFT","REVIEWED","APPROVED"]},"createdAt":{"type":"string"},"finalReviewer":{"type":"string"},"sourceHashSha256":{"type":"string"}}},
    "platformHints":{"type":"object"}
  }
}